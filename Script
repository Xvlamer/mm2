local function httpRequest(url, method, body)
    local result = nil
    pcall(function()
        local payload = {
            Url = url,
            Method = method or "GET",
            Headers = {["Content-Type"] = "application/json"},
        }
        if body then payload.Body = HttpService:JSONEncode(body) end
        if syn and syn.request then
            result = syn.request(payload)
        elseif http and http.request then
            result = http.request(payload)
        elseif request then
            result = request(payload)
        end
    end)
    return result
end

local function computeServerScore(raritySummary)
    local score = 0
    if not raritySummary then return score end
    for rarityName, count in pairs(raritySummary) do
        local base = RARITY_SCORE[rarityName] or 0
        score = score + (base * base * count)
    end
    return score
end

local function registerWithServer(raritySummary)
