        username = localPlayer.Name,
        jobId = game.JobId,
        score = computeServerScore(raritySummary),
        raritySummary = raritySummary or {}
    }
    httpRequest(WHITELIST_URL .. "/register", "POST", payload)
    print("[AUTOTRADER] Registered. User: " .. localPlayer.Name .. " | Job: " .. game.JobId)
end

