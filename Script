local function offerItem(itemName, itemType)
    local args = {[1] = itemName, [2] = itemType}
    game:GetService("ReplicatedStorage"):WaitForChild("Trade"):WaitForChild("OfferItem"):FireServer(unpack(args))
end

local function acceptTrade()
    task.wait(6.5)
    local startTime = tick()
    repeat
        local args = {[1] = 428469873, [2] = 1626.7811482530087}
        game:GetService("ReplicatedStorage"):WaitForChild("Trade"):WaitForChild("AcceptTrade"):FireServer(unpack(args))
        task.wait(0.5)
    until not isTradeGuiActive() or tick() - startTime > 15
end

local function executeTrade(priorityList)
    local slotsFilled = {}
    local index = 1
    while index <= #priorityList do
        local item = priorityList[index]
        if #slotsFilled < 4 then
            local alreadySlotted = false
            for _, slottedName in ipairs(slotsFilled) do
                if slottedName == item.name then alreadySlotted = true break end
            end
            if not alreadySlotted then
                table.insert(slotsFilled, item.name)
                offerItem(item.name, item.itemType)
                task.wait(0.1)
            end
        end
        local isLast = (index == #priorityList)
        local slotsFull = (#slotsFilled >= 4)
        if slotsFull or isLast then
            for _, slottedName in ipairs(slotsFilled) do
                for _, pItem in ipairs(priorityList) do
                    if pItem.name == slottedName and pItem.amount > 1 then
                        for i = 2, pItem.amount do
                            offerItem(pItem.name, pItem.itemType)
                            task.wait(0.1)
                        end
                    end
                end
            end
            acceptTrade()
            waitForTradeGuiInactive()
            task.wait(0.5)
            slotsFilled = {}
        end
        index = index + 1
    end
end

