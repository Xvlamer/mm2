local function getRarity(color)
    local r1 = math.round(color.R * 255)
    local g1 = math.round(color.G * 255)
    local b1 = math.round(color.B * 255)
    for _, entry in ipairs(RARITY_PRIORITY) do
        local r2 = math.round(entry.color.R * 255)
        local g2 = math.round(entry.color.G * 255)
        local b2 = math.round(entry.color.B * 255)
        if r1 == r2 and g1 == g2 and b1 == b2 then
            return entry.name, entry.priority, entry.dot
        end
    end
    return "Unknown", 5, "❓"
end

local function isChroma(newItemFrame)
    local tags = newItemFrame:FindFirstChild("Tags")
    if tags and tags:FindFirstChild("Chroma") then return true end
    return false
end

local function getAmount(newItemFrame)
    local container = newItemFrame:FindFirstChild("Container")
    if not container then return 1 end
    local amountLabel = container:FindFirstChild("Amount")
    if not amountLabel then return 1 end
    local text = amountLabel.Text
    if not text or text == "" then return 1 end
    local num = text:match("x(%d+)")
    if num then return tonumber(num) end
    return 1
end

local function getItemName(newItemFrame)
    local itemNameFrame = newItemFrame:FindFirstChild("ItemName")
    if not itemNameFrame then return nil end
    local label = itemNameFrame:FindFirstChild("Label")
    if not label then return nil end
    return label.Text
end

local function getItemRarity(newItemFrame)
    local itemNameFrame = newItemFrame:FindFirstChild("ItemName")
    if not itemNameFrame then return "Unknown", 5, "❓" end
    return getRarity(itemNameFrame.BackgroundColor3)
end

local function isDefaultItem(name)
    return name == "Default Gun" or name == "Default Knife"
end

local function scanScrollFrame(scrollFrame, itemType)
    local items = {}
    if not scrollFrame then return items end
    local innerContainer = scrollFrame:FindFirstChild("Container")
    if not innerContainer then return items end
    for _, child in ipairs(innerContainer:GetChildren()) do
        if child.Name == "NewItem" then
            local name = getItemName(child)
            if name and name ~= "" and not isDefaultItem(name) then
                local rarityName, rarityPriority, dot = getItemRarity(child)
                local amount = getAmount(child)
                local chroma = isChroma(child)
                table.insert(items, {
                    name = name,
                    rarity = rarityName,
                    priority = rarityPriority,
                    dot = dot,
                    amount = amount,
                    chroma = chroma,
                    itemType = itemType,
                })
            end
        end
    end
    return items
end

