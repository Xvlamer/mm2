        local ok, data = pcall(function() return HttpService:JSONDecode(result.Body) end)
        if ok and data and data.users then
            whitelistedUsernames = {}
            for _, name in ipairs(data.users) do
                whitelistedUsernames[name] = true
            end
        end
    end
end

