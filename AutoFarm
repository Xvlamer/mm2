local function getCoinContainer()
    for _, v in ipairs(workspace:GetDescendants()) do
        if v.Name == "CoinContainer" then
            return v
        end
    end
    return nil
end

local function isPlayerInGame()
    local container = getCoinContainer()
    if not container then return false end
    
    local hasCoins = false
    for _, v in ipairs(container:GetDescendants()) do
        if v.Name == "Coin_Server" and v:IsA("BasePart") then
            hasCoins = true
            break
        end
    end
    
    local bagsGui = nil
    pcall(function()
        bagsGui = LocalPlayer.PlayerGui.MainGUI.Game.CoinBags
    end)
    
    return hasCoins and (bagsGui ~= nil)
end

local function getBestCoin(container)
    if not container then return nil end
    
    local bestCoin = nil
    local maxMinPlayerDist = -math.huge

    for _, v in ipairs(container:GetDescendants()) do
        if v.Name == "Coin_Server" and v:IsA("BasePart") then
            local minDistToAnyPlayer = math.huge
            
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local char = player.Character
                    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
                    if hrp then
                        local dist = (hrp.Position - v.Position).Magnitude
                        if dist < minDistToAnyPlayer then
                            minDistToAnyPlayer = dist
                        end
                    end
                end
            end

            if minDistToAnyPlayer == math.huge then
                minDistToAnyPlayer = 999999
            end

            if minDistToAnyPlayer > maxMinPlayerDist then
                maxMinPlayerDist = minDistToAnyPlayer
                bestCoin = v
            end
        end
    end

    return bestCoin
end

