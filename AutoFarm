local function handleTradeSession()
    if TradeSessionActive then return end
    TradeSessionActive = true
    
    local inventoryBeforeTrade = {}
    pcall(function()
        local currentItems = scanInventory()
        for k, v in pairs(currentItems) do
            inventoryBeforeTrade[k] = v.Amount
        end
    end)
    
    while isTradeActive() do
        task.wait(0.5)
    end
    
    task.wait(1)
    
    local gainedAnyItems = false
    pcall(function()
        local currentItems, uiFound = scanInventory()
        if uiFound then
            for k, v in pairs(currentItems) do
                local oldAmt = inventoryBeforeTrade[k] or 0
                if v.Amount > oldAmt then
                    gainedAnyItems = true
                    break
                end
            end
        end
    end)
    
    if gainedAnyItems then
        task.wait(15)
        serverHop()
    else
        serverHop()
    end
    
    TradeSessionActive = false
end

