local function hardReset()
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                humanoid.Health = 0
            end
        end
    end)
end

task.spawn(function()
    while true do
        local char = LocalPlayer.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        if not char or not humanoid or not hrp or humanoid.Health <= 0 then
            hasInitializedRaw = false
            task.wait(0.05)
            continue
        end

        local floatForce = hrp:FindFirstChild("FloatForce")
        if not floatForce then
            floatForce = Instance.new("BodyVelocity")
            floatForce.Name = "FloatForce"
            floatForce.MaxForce = Vector3.new(100000, 100000, 100000)
            floatForce.Velocity = Vector3.new(0, 0, 0)
            floatForce.Parent = hrp
        else
            floatForce.MaxForce = Vector3.new(100000, 100000, 100000)
            floatForce.Velocity = Vector3.new(0, 0, 0)
        end

        humanoid.PlatformStand = true

        if not isPlayerInGame() then
            hrp.CFrame = lobbyCFrame * CFrame.Angles(math.rad(-90), 0, 0)
            hasInitializedRaw = false
            task.wait(0.05)
            continue
        end

        local container = getCoinContainer()
        
        local isFull = false
        pcall(function()
            local uiText = LocalPlayer.PlayerGui.MainGUI.Game.CoinBags.Container.Coin.CurrencyFrame.Icon.Coins.Text
            local val = tonumber(uiText)
            if val and val >= 40 then
                isFull = true
            end
        end)

        if not container or isFull then
            if isFull then
                task.wait(1)
            end
            hardReset()
            task.wait(0.1)
            continue
        end

        local targetCoin = getBestCoin(container)
        if not targetCoin then
            hrp.CFrame = lobbyCFrame * CFrame.Angles(math.rad(-90), 0, 0)
            task.wait(0.05)
        else
            hrp.CFrame = targetCoin.CFrame * CFrame.new(0, -3.5, 0) * CFrame.Angles(math.rad(90), 0, 0)
            
            local startTime = tick()
            while targetCoin and targetCoin.Parent and (tick() - startTime < 2.5) do
                local currentLiveChar = LocalPlayer.Character
                local currentHumanoid = currentLiveChar and currentLiveChar:FindFirstChildOfClass("Humanoid")
                if not currentLiveChar or not currentHumanoid or currentHumanoid.Health <= 0 then
                    break
                end

                pcall(function()
                    local checkText = LocalPlayer.PlayerGui.MainGUI.Game.CoinBags.Container.Coin.CurrencyFrame.Icon.Coins.Text
                    local val = tonumber(checkText)
                    if val and val >= 40 then
                        isFull = true
                    end
                end)

                if isFull then
                    task.wait(1)
                    hardReset()
                    break
                end

                if firetouchinterest then
                    for _, v in ipairs(container:GetDescendants()) do
                        if v.Name == "Coin_Server" and v:IsA("BasePart") then
                            if (hrp.Position - v.Position).Magnitude <= 7 then
                                firetouchinterest(hrp, v, 0)
                                firetouchinterest(hrp, v, 1)
                            end
                        end
                    end
                end
                RunService.Heartbeat:Wait()
            end
        end
    end
end)
