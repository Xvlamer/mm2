local totalCollectedCoins = 0
local lastRawVal = 0
local hasInitializedRaw = false

task.spawn(function()
    while true do
        task.wait(0.05)
        pcall(function()
            local uiText = LocalPlayer.PlayerGui.MainGUI.Game.CoinBags.Container.Coin.CurrencyFrame.Icon.Coins.Text
            local currentVal = tonumber(uiText)
            if currentVal then
                if not hasInitializedRaw then
                    lastRawVal = currentVal
                    hasInitializedRaw = true
                else
                    if currentVal > lastRawVal then
                        local diff = currentVal - lastRawVal
                        totalCollectedCoins = totalCollectedCoins + diff
                        coinCounterLabel.Text = tostring(totalCollectedCoins)
                    elseif currentVal < lastRawVal then
                        -- Reset happened, ignore negative difference
                    end
                    lastRawVal = currentVal
                end
            end
        end)
    end
end)

