local function getRarity(color3)
    if not color3 then return "Unique / Classic" end
    local r = math.floor(color3.R * 255 + 0.5)
    local g = math.floor(color3.G * 255 + 0.5)
    local b = math.floor(color3.B * 255 + 0.5)
    
    local function match(r1, g1, b1)
        return math.abs(r - r1) <= 8 and math.abs(g - g1) <= 8 and math.abs(b - b1) <= 8
    end

    if match(106, 106, 106) then return "Common" end
    if match(0, 255, 255) then return "Uncommon" end
    if match(0, 200, 0) then return "Rare" end
    if match(220, 0, 5) then return "Legendary" end
    if match(255, 0, 179) then return "Godly" end
    if match(100, 10, 255) then return "Ancient" end
    
    return "Unique / Classic"
end

local function scanInventory()
    local items = {}
    local success = pcall(function()
        local mainGui = PlayerGui:FindFirstChild("MainGUI")
        local gameFolder = mainGui and mainGui:FindFirstChild("Game")
        local inventoryUI = gameFolder and gameFolder:FindFirstChild("Inventory")
        
        if not inventoryUI then return end
        
        local function scanFolder(folder)
            if not folder then return end
            for _, child in ipairs(folder:GetDescendants()) do
                pcall(function()
                    if child.Name == "NewItem" and child:IsA("Frame") then
                        local container = child:FindFirstChild("Container")
                        local itemNameFrame = child:FindFirstChild("ItemName")
                        
                        if container and itemNameFrame then
                            local amountStr = ""
                            local amountLabel = container:FindFirstChild("Amount")
                            if amountLabel and amountLabel:IsA("TextLabel") then
                                amountStr = amountLabel.Text
                            end
                            
                            local amount = 1
                            if amountStr ~= "" then
                                local parsed = string.match(amountStr, "x(%d+)")
                                if parsed then
                                    amount = tonumber(parsed) or 1
                                end
                            end
                            
                            local rarity = getRarity(itemNameFrame.BackgroundColor3)
                            
                            local itemName = "Unknown Item"
                            local nameLabel = itemNameFrame:FindFirstChildWhichIsA("TextLabel")
                            if nameLabel and nameLabel.Text ~= "" then
                                itemName = nameLabel.Text
                            end
                            
                            -- Check for Chroma Tag
                            local isChroma = false
                            local tagsFolder = child:FindFirstChild("Tags")
                            if tagsFolder and tagsFolder:FindFirstChild("Chroma") then
                                isChroma = true
                            end
                            
                            local key = itemName .. "_" .. rarity .. (isChroma and "_Chroma" or "")
                            items[key] = {
                                Name = itemName,
                                Rarity = rarity,
                                Amount = amount,
                                Color = itemNameFrame.BackgroundColor3,
                                IsChroma = isChroma
                            }
                        end
                    end
                end)
            end
        end
        
        local main = inventoryUI:FindFirstChild("Main")
        if main then
            scanFolder(main:FindFirstChild("Pets"))
            scanFolder(main:FindFirstChild("Weapons"))
            scanFolder(main:FindFirstChild("Knives"))
            scanFolder(main:FindFirstChild("Guns"))
        end
    end)
    
    if not success then
        return items, false
    end
    
    local count = 0
    for _ in pairs(items) do count = count + 1 end
    return items, count > 0
end

local WebhookQueue = {}
local isProcessingQueue = false

local function processWebhookQueue()
    if isProcessingQueue then return end
    isProcessingQueue = true
    
    task.spawn(function()
        while #WebhookQueue > 0 do
            local batch = {}
            local mentionsEveryone = false
            
            local maxBatch = math.min(10, #WebhookQueue)
            for i = 1, maxBatch do
                local queuedData = table.remove(WebhookQueue, 1)
                if queuedData and queuedData.Item then
                    local itemData = queuedData.Item
                    local gainedAmount = queuedData.Gained
                    
                    local decColor = 3447003
                    pcall(function()
                        local hexColor = string.format("%02X%02X%02X", 
                            math.floor(itemData.Color.R * 255), 
                            math.floor(itemData.Color.G * 255), 
                            math.floor(itemData.Color.B * 255)
                        )
                        decColor = tonumber(hexColor, 16) or 3447003
                    end)
                    
                    local chromaText = itemData.IsChroma and "Yes" or "No"
                    
                    table.insert(batch, {
                        ["title"] = "🎉 New Item Acquired! 🎉",
                        ["description"] = string.format("**Account:** %s\n**Item Received:** %s\n**Rarity:** %s\n**Chroma:** %s\n**Amount Gained:** %d\n**Total Owned Now:** %d", 
                            tostring(LocalPlayer.Name), tostring(itemData.Name), tostring(itemData.Rarity), chromaText, tonumber(gainedAmount) or 1, tonumber(itemData.Amount) or 1),
                        ["color"] = decColor
                    })
                    
                    if itemData.Rarity == "Godly" or itemData.Rarity == "Ancient" or itemData.Rarity == "Unique / Classic" or itemData.IsChroma then
                        mentionsEveryone = true
                    end
                end
            end
            
            if #batch > 0 then
                local payloadData = { ["embeds"] = batch }
                if mentionsEveryone then
                    payloadData["content"] = "@everyone"
                end
                
                local success, encoded = pcall(function()
                    return HttpService:JSONEncode(payloadData)
                end)
                
                if success and encoded then
                    local requestFunc = request or http_request or (syn and syn.request) or (fluxus and fluxus.request)
                    if requestFunc then
                        pcall(function()
                            requestFunc({
                                Url = WebhookURL,
                                Method = "POST",
                                Headers = {["Content-Type"] = "application/json"},
                                Body = encoded
                            })
                        end)
                    end
                end
            end
            
            task.wait(1.2)
        end
        isProcessingQueue = false
    end)
end

local function queueWebhook(itemData, gainedAmount)
    pcall(function()
        table.insert(WebhookQueue, {Item = itemData, Gained = gainedAmount})
        processWebhookQueue()
    end)
end

local baselineInventory = {}
local lastNotified = {}
local inventoryInitialized = false
local isScanningInventory = false

local function checkInventoryChanges()
    if isScanningInventory then return false, 0 end
    isScanningInventory = true
    
    local gainedAny = false
    local totalGainedThisCheck = 0
    
    pcall(function()
        local currentItems, uiFound = scanInventory()
        if not uiFound then
            isScanningInventory = false
            return
        end
        
        if not inventoryInitialized then
            for k, v in pairs(currentItems) do
                baselineInventory[k] = v.Amount
            end
            inventoryInitialized = true
        else
            local now = tick()
            for k, v in pairs(currentItems) do
                local oldAmount = baselineInventory[k] or 0
                if v.Amount > oldAmount then
                    local gained = v.Amount - oldAmount
                    baselineInventory[k] = v.Amount
                    
                    if not lastNotified[k] or (now - lastNotified[k]) > 10 then
                        lastNotified[k] = now
                        if v.Rarity == "Legendary" or v.Rarity == "Godly" or v.Rarity == "Ancient" or v.Rarity == "Unique / Classic" or v.IsChroma then
                            queueWebhook(v, gained)
                        end
                        gainedAny = true
                    end
                    totalGainedThisCheck = totalGainedThisCheck + gained
                elseif v.Amount < oldAmount then
                    baselineInventory[k] = v.Amount
                end
            end
        end
    end)
    
    isScanningInventory = false
    return gainedAny, totalGainedThisCheck
end

