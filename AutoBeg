local rarityRank = { Common = 1, Uncommon = 2, Rare = 3, Legendary = 4, Godly = 5, Ancient = 6, Unique = 7 }

local function getRarity(color)
    if not color then
        return "Unique"
    end
    local r = math.floor(color.R * 255 + 0.5)
    local g = math.floor(color.G * 255 + 0.5)
    local b = math.floor(color.B * 255 + 0.5)
    local function match(r1, g1, b1)
        return math.abs(r - r1) <= 10 and math.abs(g - g1) <= 10 and math.abs(b - b1) <= 10
    end
    if match(106, 106, 106) then return "Common" end
    if match(0, 255, 255) then return "Uncommon" end
    if match(0, 200, 0) then return "Rare" end
    if match(220, 0, 5) then return "Legendary" end
    if match(255, 0, 179) then return "Godly" end
    if match(100, 10, 255) then return "Ancient" end
    return "Unique"
end

local function itemScore(item)
    return (rarityRank[item.Rarity] or 0) + (item.IsChroma and 10 or 0)
end

local function scanInventory()
    local items = {}
    local found = false
    pcall(function()
        local main = dig(PlayerGui, "MainGUI", "Game", "Inventory", "Main")
        if not main then
            return
        end
        found = true
        for _, folderName in ipairs({ "Pets", "Weapons", "Knives", "Guns" }) do
            local folder = main:FindFirstChild(folderName)
            if folder then
                for _, child in ipairs(folder:GetDescendants()) do
                    if child.Name == "NewItem" and child:IsA("Frame") then
                        local container = child:FindFirstChild("Container")
                        local nameFrame = child:FindFirstChild("ItemName")
                        if container and nameFrame then
                            local amount = 1
                            local amountLabel = container:FindFirstChild("Amount")
                            if amountLabel and amountLabel:IsA("TextLabel") then
                                amount = tonumber(string.match(amountLabel.Text, "x(%d+)")) or 1
                            end
                            local itemName = "Unknown Item"
                            local nameLabel = nameFrame:FindFirstChildWhichIsA("TextLabel")
                            if nameLabel and nameLabel.Text ~= "" then
                                itemName = nameLabel.Text
                            end
                            local tags = child:FindFirstChild("Tags")
                            local isChroma = tags ~= nil and tags:FindFirstChild("Chroma") ~= nil
                            local rarity = getRarity(nameFrame.BackgroundColor3)
                            items[itemName .. "_" .. rarity .. (isChroma and "_Chroma" or "")] = {
                                Name = itemName,
                                Rarity = rarity,
                                Amount = amount,
                                Color = nameFrame.BackgroundColor3,
                                IsChroma = isChroma,
                            }
                        end
                    end
                end
            end
        end
    end)
    return items, found
end

local function diffInventory(before)
    local after, found = scanInventory()
    local gained = {}
    if not found then
        return gained
    end
    for key, item in pairs(after) do
        local previous = before[key] and before[key].Amount or 0
        if item.Amount > previous then
            for _ = 1, item.Amount - previous do
                table.insert(gained, item)
            end
        end
    end
    table.sort(gained, function(a, b)
        local sa, sb = itemScore(a), itemScore(b)
        if sa ~= sb then
            return sa > sb
        end
        return a.Name < b.Name
    end)
    return gained
end

local function sendWebhook(payload)
    if not requestFunc or Config.WebhookURL == "" then
        return true, 0
    end
    local ok, res = pcall(requestFunc, {
        Url = Config.WebhookURL,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = HttpService:JSONEncode(payload),
    })
    if not ok or not res then
        return false, 3
    end
    local code = res.StatusCode or 0
    if code >= 200 and code < 300 then
        return true, 0
    end
    if code == 429 then
        local delay = 3
        pcall(function()
            local decoded = HttpService:JSONDecode(res.Body)
            if decoded and decoded.retry_after then
                delay = decoded.retry_after + 0.5
            end
        end)
        return false, delay
    end
    return true, 0
end

local function postTradeSuccess(gained, partner)
