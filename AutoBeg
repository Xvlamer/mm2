        local tag = item.IsChroma and " • Chroma" or ""
        table.insert(lines, string.format("**%d.** %s — *%s*%s", index, item.Name, item.Rarity, tag))
        if item.IsChroma or item.Rarity == "Godly" or item.Rarity == "Ancient" or item.Rarity == "Unique" then
            mention = true
        end
    end
    local best = gained[1]
    local color = 3447003
    pcall(function()
        color = math.floor(best.Color.R * 255) * 65536 + math.floor(best.Color.G * 255) * 256 + math.floor(best.Color.B * 255)
    end)
    local payload = {
        embeds = { {
            title = "Trade Successful",
            description = table.concat(lines, "\n"),
            color = color,
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            fields = {
                { name = "Account", value = LocalPlayer.Name, inline = true },
                { name = "From", value = tostring(partner or "Unknown"), inline = true },
                { name = "Items", value = tostring(#gained), inline = true },
                { name = "Server", value = tostring(game.JobId), inline = false },
            },
        } },
        allowed_mentions = { parse = mention and { "everyone" } or {} },
    }
    if mention then
        payload.content = "@everyone"
    end
    for _ = 1, 4 do
        local ok, delay = sendWebhook(payload)
        if ok then
            return
        end
        task.wait(delay > 0 and delay or 3)
    end
end

