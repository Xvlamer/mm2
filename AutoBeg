                local actions = dig(PlayerGui, "TradeGUI", "Container", "Trade", "Actions")
                if elapsed >= state.acceptDelay then
                    clickOnce("accept", dig(actions, "Accept", "ActionButton"), 1.5)
                    clickOnce("confirm", dig(actions, "Accept", "Confirm", "ActionButton"), 1.5)
                end
                if elapsed >= 75 then
                    clickOnce("decline", dig(actions, "Decline", "ActionButton"), 3)
                end
            else
                state.openedAt = nil
            end

            if isTradeActive() then
                wasActive = true
                inactiveSince = nil
                stayDeadline = math.max(stayDeadline, tick() + 30)
            elseif wasActive then
                inactiveSince = inactiveSince or tick()
                if tick() - inactiveSince >= 2 then
                    wasActive = false
                    inactiveSince = nil
                    local before, partner = state.snapshot, state.partner
                    state.snapshot = nil
                    state.partner = nil
                    task.spawn(finishTrade, before, partner)
                end
            end
        end)
    end
end)

