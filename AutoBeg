local function serverHop()
    if getgenv().IsHopping then return end
    if isTradeActive() then return end

    getgenv().IsHopping = true
    blacklistServer(tostring(game.JobId))
    registerTeleportQueue()

    local staggerDelay = (altNumber - 1) * 1.5
    if staggerDelay > 0 then task.wait(staggerDelay) end

    task.spawn(function()
        local req = (request or http_request or (syn and syn.request) or (fluxus and fluxus.request))
        local targetServer = nil

        while not targetServer do
            local blacklist = getBlacklist()
            -- Added unique cache-buster parameter to prevent stale/cached API responses
            local url = "https://games.roproxy.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=100&_t=" .. tostring(tick())

            local success, responseText = pcall(function()
                if req then
                    local res = req({Url = url, Method = "GET"})
                    if res and res.StatusCode == 200 then return res.Body end
                end
                return game:HttpGet(url)
            end)

            if success and responseText then
                local ok, data = pcall(HttpService.JSONDecode, HttpService, responseText)
                if ok and data and data.data then
                    local validServers = {}
                    for _, srv in ipairs(data.data) do
                        if type(srv) == "table" and srv.id and tostring(srv.id) ~= tostring(game.JobId) then
                            local idStr = tostring(srv.id)
                            if not blacklist[idStr] then
                                if srv.playing and srv.maxPlayers and srv.playing < srv.maxPlayers then
                                    table.insert(validServers, idStr)
                                end
                            end
                        end
                    end
                    
                    if #validServers > 0 then
                        targetServer = validServers[math.random(1, #validServers)]
                    end
                end
            end
            
            if not targetServer then
                task.wait(2)
            end
        end

        blacklistServer(targetServer)

        -- Safe teleport attempt block: prevents infinite looping on a broken/full server instance
        local tpSuccess = false
        local attempts = 0
        while not tpSuccess and attempts < 3 do
            attempts = attempts + 1
            local ok = pcall(function()
                TeleportService:TeleportToPlaceInstance(PlaceId, targetServer, LocalPlayer)
            end)
            if ok then
                tpSuccess = true
            else
                task.wait(2)
            end
        end

        if not tpSuccess then
            getgenv().IsHopping = false
            task.wait(1)
            serverHop()
        end
    end)
end

