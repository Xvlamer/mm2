local function getBlacklist()
    local list = {}
    -- Load from session first (most reliable)
    for k, v in pairs(getgenv().SessionBlacklist) do
        list[k] = v
    end
    -- Merge from file if available
    if isfile(BlacklistFile) then
        local success, content = pcall(readfile, BlacklistFile)
        if success and content then
            local ok, decoded = pcall(HttpService.JSONDecode, HttpService, content)
            if ok and type(decoded) == "table" then
                for jobId, timestamp in pairs(decoded) do
                    if type(timestamp) == "number" then
                        list[tostring(jobId)] = timestamp
                    end
                end
            end
        end
    end
    return list
end

local function blacklistServer(jobId)
    if not jobId or jobId == "" then return end
    local sId = tostring(jobId)
    getgenv().SessionBlacklist[sId] = os.time()
    
    local list = getBlacklist()
    list[sId] = os.time()
    
    pcall(function()
        writefile(BlacklistFile, HttpService:JSONEncode(list))
    end)
    pcall(function()
        writefile(LastServerFile, sId)
    end)
end

