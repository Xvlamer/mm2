local function isServerBlocked(jobId)
    if not jobId or jobId == "" then return true end
    local strId = tostring(jobId)
    if MemoryBlacklist[strId] then return true end
    if strId == tostring(game.JobId) then return true end
    
    local blocked = false
    pcall(function()
        local currentTime = os.time()
        
        local blacklist = getSharedTable(SharedBlacklistFile)
        if blacklist[strId] then
            if currentTime - blacklist[strId] < 86400 then
                blocked = true
                MemoryBlacklist[strId] = true
                return
            end
        end
        
        local active = getSharedTable(SharedActiveFile)
        if active[strId] then
            if (currentTime - (active[strId].time or 0)) < 3600 then
                blocked = true
                MemoryBlacklist[strId] = true
                return
            end
        end
    end)
    return blocked
end

