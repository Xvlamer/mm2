local function getBlacklist()
    local list = {}
    for k, v in pairs(getgenv().SessionBlacklist) do list[k] = v end
    if hasFileIO and isfile(BlacklistFile) then
        local s, c = pcall(readfile, BlacklistFile)
        if s and c then
            local ok, d = pcall(HttpService.JSONDecode, HttpService, c)
            if ok and type(d) == "table" then
                for j, t in pairs(d) do
                    if type(t) == "number" then list[tostring(j)] = t end
                end
            end
        end
    end
    return list
end

local function blacklistServer(jobId)
    if not jobId or jobId == "" then return end
    local sId = tostring(jobId)
    getgenv().SessionBlacklist[sId] = os.time()
    local list = getBlacklist()
    list[sId] = os.time()
    if hasFileIO then
        pcall(function() writefile(BlacklistFile, HttpService:JSONEncode(list)) end)
        pcall(function() writefile(LastServerFile, sId) end)
    end
end

