    local staggerDelay = (LocalPlayer.UserId % 10) * 0.8
    if staggerDelay > 0 then task.wait(staggerDelay) end

    task.spawn(function()
        local req = (request or http_request or (syn and syn.request) or (fluxus and fluxus.request))
        local targetServer = nil

        print("[TradeBot] Fetching brand new/low-population servers...")

        if req then
            local success, responseText = pcall(function()
                local res = req({
                    Url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&excludeFullGames=true&limit=100",
                    Method = "GET",
                    Headers = { ["User-Agent"] = "Mozilla/5.0" }
                })
                if res and (res.StatusCode == 200 or res.status_code == 200) then
                    return res.Body or res.body
                end
                error("Request failed")
            end)

            if success and responseText then
                local ok, data = pcall(function() return HttpService:JSONDecode(responseText) end)
                if ok and data and data.data then
                    local bl = getBlacklist()
                    local lastServer = getLastServer()
                    local validServers = {}
                    
                    for _, srv in ipairs(data.data) do
                        if type(srv) == "table" and srv.id then
                            local srvIdStr = tostring(srv.id)
                            -- Exclude current server, last server, and any globally visited servers
                            if srvIdStr ~= currentJobId and srvIdStr ~= lastServer then
                                -- Target brand new / low-population servers (>= 1 player)
                                if srv.playing and srv.maxPlayers and srv.playing >= 1 and srv.playing < srv.maxPlayers then
                                    if not bl[srvIdStr] then
                                        table.insert(validServers, srv)
                                    end
                                end
                            end
                        end
                    end

                    if #validServers > 0 then
                        -- MATHEMATICAL ZERO-COLLISION INDEX:
                        -- Every single account picks a completely different index based on its UserId.
                        local targetIndex = (LocalPlayer.UserId % #validServers) + 1
                        local chosenSrv = validServers[targetIndex] or validServers[1]

