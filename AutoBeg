local function checkDangerWords(text)
    local lowerText = string.lower(text)
    local words = {"bot", "ai", "report", "ban", "scam", "hacker", "hack", "automated", "macro", "autoclicker", "alt", "detector", "exploiter", "exploit", "cheater", "cheat", "botting", "moderator", "mod", "admin"}
    for _, word in ipairs(words) do
        if string.find(lowerText, word) then return true end
    end
    return false
end

local function isValidTradeResponse(msg)
    local lower = string.lower(string.gsub(msg, "^%s*(.-)%s*$", "%1"))
    local phrases = {"me", "ok", "sure", "alright", "allright", "ok bet", "i can", "i got", "bet", "yep", "yeah", "i do"}
    for _, phrase in ipairs(phrases) do
        if lower == phrase then return true end
    end
    return false
end

local lastTradeResponseTime = 0

