local function getLastServer()
    if not isfile(LastServerFile) then return nil end
    local success, content = pcall(readfile, LastServerFile)
    if success and content then
        return string.gsub(content, "^%s*(.-)%s*$", "%1")
    end
    return nil
end

local function setLastServer(jobId)
    pcall(function()
        writefile(LastServerFile, tostring(jobId))
    end)
end

local function getBlacklist()
    if not isfile(BlacklistFile) then return {} end
    local success, content = pcall(readfile, BlacklistFile)
    if success and content then
        local ok, decoded = pcall(HttpService.JSONDecode, HttpService, content)
        if ok and type(decoded) == "table" then
            local currentTime = os.time()
            local cleaned = {}
            for jobId, timestamp in pairs(decoded) do
                if type(timestamp) == "number" and (currentTime - timestamp) < 7200 then
                    cleaned[jobId] = timestamp
                end
            end
            return cleaned
        end
    end
    return {}
end

local function saveBlacklist(list)
    pcall(function()
        writefile(BlacklistFile, HttpService:JSONEncode(list))
    end)
end

local function blacklistServer(jobId)
    if not jobId or jobId == "" then return end
    local list = getBlacklist()
    list[tostring(jobId)] = os.time()
    saveBlacklist(list)
end

local function canSpeakInServer()
    local list = {}
    if isfile(SpokenFile) then
        local success, content = pcall(readfile, SpokenFile)
        if success and content then
            local ok, decoded = pcall(HttpService.JSONDecode, HttpService, content)
            if ok and type(decoded) == "table" then list = decoded end
        end
    end
    
    local currentJobId = tostring(game.JobId)
    if list[currentJobId] then
        return false
    end
    
    list[currentJobId] = os.time()
    local currentTime = os.time()
    for jId, ts in pairs(list) do
        if type(ts) == "number" and (currentTime - ts) > 3600 then
            list[jId] = nil
        end
    end
    
    pcall(function()
        writefile(SpokenFile, HttpService:JSONEncode(list))
    end)
    return true
end

