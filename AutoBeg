local function fetchServers(blocked)
    local candidates = {}
    local cursor = ""
    for _ = 1, 6 do
        local page
        for _, host in ipairs({ "games.roblox.com", "games.roproxy.com" }) do
            local url = string.format("https://%s/v1/games/%d/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=100", host, Config.PlaceId)
            if cursor ~= "" then
                url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
            end
            local status, body = httpGet(url)
            if status == 200 and body then
                local ok, decoded = pcall(HttpService.JSONDecode, HttpService, body)
                if ok and type(decoded) == "table" and type(decoded.data) == "table" then
                    page = decoded
                    break
                end
            elseif status == 429 then
                task.wait(2 + math.random() * 2)
            end
        end
        if not page then
            break
        end
        for _, server in ipairs(page.data) do
            if type(server) == "table" and server.id and server.playing and server.maxPlayers then
                local id = tostring(server.id)
                if not blocked[id] and server.playing >= Config.MinPlayers and server.maxPlayers - server.playing >= Config.MinFreeSlots then
                    table.insert(candidates, id)
                end
            end
        end
        cursor = page.nextPageCursor
        if type(cursor) ~= "string" or cursor == "" or #candidates >= 30 then
            break
        end
        task.wait(0.4)
    end
    return candidates
end

