local function compilePatterns(words)
    local patterns = {}
    for _, word in ipairs(words) do
        table.insert(patterns, "%f[%w]" .. word .. "%f[%W]")
    end
    return patterns
end

local hardPatterns = compilePatterns({
    "report", "reported", "reporting", "moderator", "moderators", "admin", "admins", "mod", "mods",
})

local botPatterns = compilePatterns({
    "bot", "bots", "botting", "ai", "macro", "macros", "autoclicker", "automated", "automation",
    "script", "scripted", "scripter", "scripting", "exploiter", "exploiting", "hacker", "hacking",
    "alt", "alts", "cheater", "cheating", "scam", "scammer", "scamming", "ban", "banned",
})

local targetPatterns = compilePatterns({ "you", "u", "ur", "your", "youre", "ya", "yall" })

local function matchesAny(patterns, text)
    for _, pattern in ipairs(patterns) do
        if string.find(text, pattern) then
            return true
        end
    end
    return false
end

local function isDanger(text)
    local lower = string.lower(text)
    if matchesAny(hardPatterns, lower) then
        return true
    end
    if matchesAny(botPatterns, lower) then
        if matchesAny(targetPatterns, lower) then
            return true
        end
        if string.find(lower, string.lower(LocalPlayer.Name), 1, true) then
            return true
        end
        local display = string.lower(LocalPlayer.DisplayName)
        if #display >= 3 and string.find(lower, display, 1, true) then
            return true
        end
    end
    return false
end

local offerPrefixes = { "i can", "i got", "i have", "i ll", "ill", "sure", "ok", "okay", "me", "yes", "yeah", "yep", "yea", "bet", "alright", "allright" }

local function normalizeText(text)
    local s = string.lower(text)
    s = string.gsub(s, "%p", " ")
    s = string.gsub(s, "%s+", " ")
    return string.match(s, "^%s*(.-)%s*$")
end

local function isTradeOffer(text)
    if #text > 45 then
        return false
    end
    local s = normalizeText(text)
    if s == "" then
        return false
    end
    local _, spaces = string.gsub(s, " ", "")
    if spaces > 3 then
        return false
    end
    for _, prefix in ipairs(offerPrefixes) do
        if s == prefix or string.sub(s, 1, #prefix + 1) == prefix .. " " then
            return true
        end
    end
    return false
end

