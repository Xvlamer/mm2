local function serverHop()
    print("[Bot] Server hop triggered...")

    -- Strict pre-hop verification: Re-check trade activity multiple times to prevent leaving while TradeGUI is visible
    for i = 1, 10 do
        if isTradeActive() then
            print("[Bot] Trade GUI is active/visible! Aborting server hop.")
            return
        end
        task.wait(0.2)
    end

    while isTradeActive() do
        task.wait(0.2)
    end

    pcall(function()
        if queue_on_teleport then
            queue_on_teleport(string.format([[
                if not getgenv().TradeBotQueued then
                    getgenv().TradeBotQueued = true
                    task.spawn(function()
                        task.wait(3)
                        pcall(function()
                            loadstring(game:HttpGet("%s", true))()
                        end)
                    end)
                end
            ]], RawScriptURL))
        end
    end)

    blacklistServer(tostring(game.JobId))

    local staggerDelay = (altNumber - 1) * 2
    if staggerDelay > 0 then
        print("[Bot] Alt " .. altNumber .. " staggering " .. staggerDelay .. "s...")
        task.wait(staggerDelay)
    end

    print("[Bot] Scanning for unvisited server...")

    local candidates = {}
    local cursor = ""

    for attempt = 1, 20 do
        local url = "https://games.roproxy.com/v1/games/" .. tostring(PlaceId)
            .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursor ~= "" then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local ok, result = pcall(function()
            return game:HttpGet(url)
        end)

        if not ok or not result then
            task.wait(1)
            continue
        end

        local decodeOk, data = pcall(HttpService.JSONDecode, HttpService, result)
        if not decodeOk or not data or not data.data then
            break
        end

        local blacklist = readBlacklist()

        for _, server in ipairs(data.data) do
            pcall(function()
                if type(server) ~= "table" then return end
                local sid = tostring(server.id or "")
                if sid == "" then return end
                if blacklist[sid] then return end
                if sid == tostring(game.JobId) then return end
                if not server.maxPlayers or not server.playing then return end
                if server.playing >= server.maxPlayers then return end
                table.insert(candidates, sid)
            end)
        end

        if #candidates >= 10 then
            break
        end

        if data.nextPageCursor and data.nextPageCursor ~= "" then
            cursor = data.nextPageCursor
            task.wait(0.3)
        else
            break
        end
    end

    if #candidates == 0 then
        print("[Bot] No unvisited servers found. Random teleport — blacklist preserved.")
        task.wait(2)
        TeleportService:Teleport(PlaceId, LocalPlayer)
        return
    end

    for i = #candidates, 2, -1 do
        local j = math.random(i)
        candidates[i], candidates[j] = candidates[j], candidates[i]
    end

    local pickIndex = math.random(math.ceil(#candidates / 2), #candidates)
    local target = candidates[pickIndex]

    local finalCheck = readBlacklist()
    if finalCheck[target] then
        for _, sid in ipairs(candidates) do
            if not finalCheck[sid] then
                target = sid
                break
            end
        end
    end

    blacklistServer(target)
    print("[Bot] Teleporting to: " .. target)
    task.wait(0.1)
    TeleportService:TeleportToPlaceInstance(PlaceId, target, LocalPlayer)
end

