local function checkDangerWords(text)
    local lowerText = string.lower(text)
    local words = {
        "bot", "ai", "report", "ban", "scam", "scammer", "hacker", "hack",
        "automated", "automation", "system", "script", "macro",
        "autoclicker", "alt", "banned", "scammed", "detector",
        "detecting", "exploiter", "exploit", "cheater", "cheat", "fraud", "stealer",
        "botting", "suspicious", "bypass", "moderator", "mod", "admin"
    }
    for _, word in ipairs(words) do
        if string.find(lowerText, word) then
            return true
        end
    end
    return false
end

local function isValidTradeResponse(msg)
    local lower = string.lower(msg)
    lower = string.gsub(lower, "^%s*(.-)%s*$", "%1")
    
    local validPhrases = {
        "me", "ok", "sure", "alright", "allright", "ok bet", 
        "i can", "i got", "bet", "yep", "yeah"
    }
    
    for _, phrase in ipairs(validPhrases) do
        if lower == phrase then
            return true
        end
    end
    
    return false
end

