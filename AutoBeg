local function getSharedTable(filePath)
    local tbl = {}
    pcall(function()
        if isfile and isfile(filePath) then
            local content = readfile(filePath)
            local decoded = HttpService:JSONDecode(content)
            if type(decoded) == "table" then
                tbl = decoded
            end
        end
    end)
    return tbl
end

local function saveSharedTable(filePath, tbl)
    pcall(function()
        if writefile then
            writefile(filePath, HttpService:JSONEncode(tbl))
        end
    end)
end

local function addServerToSharedBlacklist(jobId)
    if not jobId or jobId == "" then return end
    pcall(function()
        local blacklist = getSharedTable(SharedBlacklistFile)
        blacklist[tostring(jobId)] = os.time()
        saveSharedTable(SharedBlacklistFile, blacklist)
    end)
end

local function claimServerForAccount(jobId, accountName)
    if not jobId or jobId == "" then return end
    pcall(function()
        local active = getSharedTable(SharedActiveFile)
        active[tostring(jobId)] = {
            account = accountName,
            time = os.time()
        }
        saveSharedTable(SharedActiveFile, active)
        addServerToSharedBlacklist(jobId)
    end)
end

local function isServerBlocked(jobId)
    if not jobId or jobId == "" then return true end
    if jobId == game.JobId then return true end
    
    local blocked = false
    pcall(function()
        local strId = tostring(jobId)
        
        local blacklist = getSharedTable(SharedBlacklistFile)
        if blacklist[strId] then
            blocked = true
            return
        end
        
        local active = getSharedTable(SharedActiveFile)
        if active[strId] then
            if (os.time() - (active[strId].time or 0)) < 900 then
                blocked = true
                return
            end
        end
    end)
    return blocked
end

