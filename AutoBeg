local function getRarity(color3)
    if not color3 then return "Unique / Classic" end
    local r, g, b = math.floor(color3.R*255+0.5), math.floor(color3.G*255+0.5), math.floor(color3.B*255+0.5)
    local function match(r1, g1, b1) return math.abs(r-r1)<=8 and math.abs(g-g1)<=8 and math.abs(b-b1)<=8 end
    if match(106, 106, 106) then return "Common" end
    if match(0, 255, 255) then return "Uncommon" end
    if match(0, 200, 0) then return "Rare" end
    if match(220, 0, 5) then return "Legendary" end
    if match(255, 0, 179) then return "Godly" end
    if match(100, 10, 255) then return "Ancient" end
    return "Unique / Classic"
end

local function scanInventory()
    local items = {}
    local success = pcall(function()
        local inventoryUI = PlayerGui:FindFirstChild("MainGUI") and PlayerGui.MainGUI:FindFirstChild("Game") and PlayerGui.MainGUI.Game:FindFirstChild("Inventory")
        if not inventoryUI or not inventoryUI:FindFirstChild("Main") then return end

        local function scanFolder(folder)
            if not folder then return end
            for _, child in ipairs(folder:GetDescendants()) do
                if child.Name == "NewItem" and child:IsA("Frame") then
                    local container = child:FindFirstChild("Container")
                    local itemNameFrame = child:FindFirstChild("ItemName")
                    if container and itemNameFrame then
                        local amountStr = container:FindFirstChild("Amount") and container.Amount:IsA("TextLabel") and container.Amount.Text or ""
                        local amount = tonumber(string.match(amountStr, "x(%d+)")) or 1
                        local rarity = getRarity(itemNameFrame.BackgroundColor3)
                        local isChroma = (child:FindFirstChild("Tags") and child.Tags:FindFirstChild("Chroma")) and "Yes" or "No"
                        local nameLabel = itemNameFrame:FindFirstChildWhichIsA("TextLabel")
                        local itemName = (nameLabel and nameLabel.Text ~= "") and nameLabel.Text or "Unknown Item"
                        
                        items[itemName .. "_" .. rarity .. "_" .. isChroma] = {
                            Name = itemName, Rarity = rarity, Chroma = isChroma, Amount = amount, Color = itemNameFrame.BackgroundColor3
                        }
                    end
                end
            end
        end

        local main = inventoryUI.Main
        scanFolder(main:FindFirstChild("Pets"))
        scanFolder(main:FindFirstChild("Weapons"))
        scanFolder(main:FindFirstChild("Knives"))
        scanFolder(main:FindFirstChild("Guns"))
    end)
    return items, success and next(items) ~= nil
end

local WebhookQueue = {}
local isProcessingQueue = false
local function processWebhookQueue()
    if isProcessingQueue then return end
    isProcessingQueue = true
    task.spawn(function()
        while #WebhookQueue > 0 do
            local batch = {}
            local mentionsEveryone = false
            for i = 1, math.min(10, #WebhookQueue) do
                local queued = table.remove(WebhookQueue, 1)
                local item = queued.Item
                local rarityStr = tostring(item.Rarity)
                
                if rarityStr == "Legendary" or rarityStr == "Godly" or rarityStr == "Ancient" or rarityStr == "Unique / Classic" then
                    local hexColor = string.format("%02X%02X%02X", math.floor(item.Color.R*255), math.floor(item.Color.G*255), math.floor(item.Color.B*255))
                    table.insert(batch, {
                        ["title"] = "🎉 New Item Acquired! 🎉",
                        ["description"] = string.format("**Account:** %s\n**Item:** %s\n**Rarity:** %s\n**Chroma:** %s\n**Gained:** %d\n**Total:** %d",
                            LocalPlayer.Name, item.Name, rarityStr, item.Chroma, queued.Gained, item.Amount),
                        ["color"] = tonumber(hexColor, 16) or 3447003
                    })
                    if rarityStr ~= "Legendary" then mentionsEveryone = true end
                end
            end
            
            if #batch > 0 then
                local payload = { ["embeds"] = batch }
                if mentionsEveryone then payload["content"] = "@everyone" end
                pcall(function()
                    local req = request or http_request or (syn and syn.request) or (fluxus and fluxus.request)
                    if req then req({Url = WebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(payload)}) end
                end)
            end
            task.wait(1.5)
        end
        isProcessingQueue = false
    end)
end

