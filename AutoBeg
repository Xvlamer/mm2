        end
        
        if hasTradedInServer then
            if noTradeTimer > 0 then
                noTradeTimer = noTradeTimer - 0.5
                if noTradeTimer <= 0 then
                    serverHop()
                    return
                end
            end
        else
            local elapsed = tick() - startTime

            if elapsed >= 1 and not sentMsg1 then
                msg1Index = math.random(1, #initialMessages)
                sendMessage(initialMessages[msg1Index])
                sentMsg1 = true
            end

            if elapsed >= 60 then
                serverHop()
                return
            end
        end
    end
end)
