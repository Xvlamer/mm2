local function readJson(path)
    if not canFile then
        return nil
    end
    local ok, result = pcall(function()
        if isfile(path) then
            return HttpService:JSONDecode(readfile(path))
        end
    end)
    if ok and type(result) == "table" then
        return result
    end
    return nil
end

local function writeJson(path, tbl)
    if canFile then
        pcall(function()
            writefile(path, HttpService:JSONEncode(tbl))
        end)
    end
end

local function httpGet(url)
    if requestFunc then
        local ok, res = pcall(requestFunc, { Url = url, Method = "GET" })
        if ok and res then
            return res.StatusCode, res.Body
        end
        return 0, nil
    end
    local ok, body = pcall(game.HttpGet, game, url)
    if ok then
        return 200, body
    end
    return 0, nil
end

local function dig(root, ...)
    local node = root
    for _, name in ipairs({ ... }) do
        if not node then
            return nil
        end
        node = node:FindFirstChild(name)
    end
    return node
end

local function pickUnique(pool, recent, memory)
    local choice = pool[math.random(#pool)]
    for _ = 1, 20 do
        choice = pool[math.random(#pool)]
        if not table.find(recent, choice) then
            break
        end
    end
    table.insert(recent, choice)
    if #recent > memory then
        table.remove(recent, 1)
    end
    return choice
end

