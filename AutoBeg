local function checkDangerWords(text)
    local lowerText = string.lower(text)
    local words = {"bot", "ai", "report", "ban", "scam", "hacker", "hack", "automated", "automation", "macro", "autoclicker", "alt", "detector", "exploiter", "exploit", "cheater", "cheat", "botting", "moderator", "mod", "admin"}
    for _, word in ipairs(words) do
        if string.find(lowerText, word) then return true end
    end
    return false
end

local function isValidTradeResponse(msg)
    local lower = string.lower(string.gsub(msg, "^%s*(.-)%s*$", "%1"))
    local phrases = {"me", "ok", "sure", "alright", "allright", "ok bet", "i can", "i got", "bet", "yep", "yeah", "i do"}
    for _, phrase in ipairs(phrases) do
        if lower == phrase then return true end
    end
    return false
end

local lastTradeResponseTime = 0

local function setupChatListener()
    local function processMsg(senderId, msgText)
        if senderId == LocalPlayer.UserId then return end
        if checkDangerWords(msgText) then
            if not isTradeActive() then serverHop() end
            return
        end
        if isValidTradeResponse(msgText) then
            if not isTradeActive() then
                local currentTime = tick()
                if currentTime - lastTradeResponseTime >= 10 then
                    lastTradeResponseTime = currentTime
                    task.spawn(function()
                        task.wait(1.5)
                        sendMessage("ok trade me")
                    end)
                end
            end
        end
    end

    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            TextChatService.TextChannels.RBXGeneral.MessageReceived:Connect(function(msg)
                if msg.TextSource then processMsg(msg.TextSource.UserId, msg.Text) end
            end)
        else
            local function attachPlayerChat(player)
                player.Chatted:Connect(function(msg)
                    processMsg(player.UserId, msg)
                end)
            end
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then attachPlayerChat(player) end
            end
            Players.PlayerAdded:Connect(attachPlayerChat)
        end
    end)
end
