local function getSharedTable(filePath)
    local tbl = {}
    local success = pcall(function()
        if isfile and isfile(filePath) then
            local content = readfile(filePath)
            if content and content ~= "" then
                local decoded = HttpService:JSONDecode(content)
                if type(decoded) == "table" then
                    tbl = decoded
                end
            end
        end
    end)
    if not success or type(tbl) ~= "table" then 
        tbl = {} 
    end
    return tbl
end

local function saveSharedTable(filePath, tbl)
    pcall(function()
        if writefile then
            local cleanedTbl = {}
            local currentTime = os.time()
            
            for k, v in pairs(tbl) do
                if type(v) == "table" and v.time then
                    if currentTime - v.time < 86400 then
                        cleanedTbl[tostring(k)] = v
                    end
                elseif type(v) == "number" then
                    if currentTime - v < 86400 then
                        cleanedTbl[tostring(k)] = v
                    end
                else
                    cleanedTbl[tostring(k)] = v
                end
            end
            
            writefile(filePath, HttpService:JSONEncode(cleanedTbl))
        end
    end)
end

