            sendMessage(initialMessagesList[index])
        end

        if not sentSecondMsg and elapsed >= 40 and sentMessagesCount < msgCountToSend and #availableIndices > 0 then
            sentSecondMsg = true
            sentMessagesCount = sentMessagesCount + 1
            local index = table.remove(availableIndices, 1)
            sendMessage(initialMessagesList[index])
        end

        if currentlyActive then
            hasTradedInServer = true
            wasActiveLastCheck = true
            noTradeTimer = 10
            continue
        end

        if wasActiveLastCheck and not currentlyActive then
            wasActiveLastCheck = false
            noTradeTimer = 10
            task.spawn(function()
                task.wait(0.5)
                if checkInventoryChanges() then
                    itemsGainedThisTrade = true
                end
            end)
        end

        if hasTradedInServer then
            if noTradeTimer > 0 then
                noTradeTimer = noTradeTimer - 0.5
                if noTradeTimer <= 0 then
                    print("[Bot] Trade timer expired. Commencing hop.")
                    serverHop()
                    return
                end
            end
        else
            if elapsed >= 70 then
                print("[Bot] Server time expired without trade. Commencing hop.")
                serverHop()
                return
            end
        end
    end
end)
