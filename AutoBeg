local function fetchAndTeleport()
    local currentJobId = tostring(game.JobId)
    blacklistServer(currentJobId)
    registerTeleportQueue()
    local staggerDelay = (LocalPlayer.UserId % 10) * 0.5
    if staggerDelay > 0 then task.wait(staggerDelay) end

    while true do
        if type(reqFunc) == "function" then
            local success, responseText = pcall(function()
                local res = reqFunc({
                    Url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Desc&excludeFullGames=true&limit=100",
                    Method = "GET",
                    Headers = { ["User-Agent"] = "Mozilla/5.0" }
                })
                if res and (res.StatusCode == 200 or res.status_code == 200) then
                    return res.Body or res.body
                end
                error("Fetch Fail")
            end)

            if success and responseText then
                local ok, data = pcall(function() return HttpService:JSONDecode(responseText) end)
                if ok and data and data.data then
                    local bl = getBlacklist()
                    local validServers = {}
                    for _, srv in ipairs(data.data) do
                        if type(srv) == "table" and srv.id then
                            local srvIdStr = tostring(srv.id)
                            if srvIdStr ~= currentJobId and not bl[srvIdStr] then
                                if srv.playing and srv.maxPlayers then
                                    if srv.playing >= (srv.maxPlayers - 4) and srv.playing < srv.maxPlayers then
                                        table.insert(validServers, srv)
                                    end
                                end
                            end
                        end
                    end
                    if #validServers > 0 then
                        local chosenSrv = validServers[math.random(1, #validServers)]
                        local targetServer = tostring(chosenSrv.id)
                        blacklistServer(targetServer)
                        registerTeleportQueue()
                        pcall(function()
                            TeleportService:TeleportToPlaceInstance(PlaceId, targetServer, LocalPlayer)
                        end)
                        task.wait(8)
                    end
                end
            end
        end
        task.wait(2.5)
    end
end

