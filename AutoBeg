local function readBlacklist()
    local tbl = {}
    pcall(function()
        if isfile and isfile(SharedVisitedFile) then
            local raw = readfile(SharedVisitedFile)
            if raw and raw ~= "" then
                local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
